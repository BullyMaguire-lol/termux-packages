diff -ruN a/src/modules/oboe-shim.cpp b/src/modules/oboe-shim.cpp
--- a/src/modules/oboe-shim.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/modules/oboe-shim.cpp	2026-08-14 09:57:26.529122133 +0000
@@ -0,0 +1,272 @@
+#include "oboe-shim.h"
+
+#include <cstring>
+#include <oboe/Oboe.h>
+
+#include <atomic>
+#include <memory>
+
+class RingBufferDataCallback : public oboe::AudioStreamDataCallback,
+				public oboe::AudioStreamErrorCallback {
+public:
+	explicit RingBufferDataCallback(struct oboe_shim_ring *ring, int32_t frame_bytes,
+			oboe_shim_trigger_func trigger_cb, void *trigger_data)
+		: mRing(ring), mFrameBytes(frame_bytes),
+		  mTriggerCb(trigger_cb), mTriggerData(trigger_data) {}
+
+	oboe::DataCallbackResult onAudioReady(oboe::AudioStream *stream,
+			void *audioData, int32_t numFrames) override
+	{
+		uint32_t index;
+		int32_t avail;
+		int32_t want = numFrames * mFrameBytes;
+
+		avail = spa_ringbuffer_get_read_index(&mRing->rb, &index);
+		if (avail <= 0) {
+			if (__atomic_load_n(&mRing->active, __ATOMIC_RELAXED))
+				mUnderrunCount.fetch_add(1, std::memory_order_relaxed);
+			memset(audioData, 0, want);
+		} else {
+			if (avail > want)
+				avail = want;
+
+			spa_ringbuffer_read_data(&mRing->rb, mRing->buffer,
+					OBOE_SHIM_RING_SIZE, index & OBOE_SHIM_RING_MASK,
+					audioData, avail);
+
+			if (avail < want)
+				memset(SPA_PTROFF(audioData, avail, void), 0, want - avail);
+
+			spa_ringbuffer_read_update(&mRing->rb, index + avail);
+		}
+
+		if (mTriggerCb != nullptr)
+			mTriggerCb(mTriggerData);
+
+		return oboe::DataCallbackResult::Continue;
+	}
+
+	void onErrorAfterClose(oboe::AudioStream * /* stream */, oboe::Result /* error */) override
+	{
+		mDisconnected.store(true, std::memory_order_relaxed);
+	}
+
+	int32_t getUnderrunCount() const
+	{
+		return mUnderrunCount.load(std::memory_order_relaxed);
+	}
+
+	bool isDisconnected() const
+	{
+		return mDisconnected.load(std::memory_order_relaxed);
+	}
+
+private:
+	struct oboe_shim_ring *mRing;
+	int32_t mFrameBytes;
+	oboe_shim_trigger_func mTriggerCb;
+	void *mTriggerData;
+	std::atomic<int32_t> mUnderrunCount{0};
+	std::atomic<bool> mDisconnected{false};
+};
+
+struct OboeShimStream {
+	std::shared_ptr<oboe::AudioStream> stream;
+	std::unique_ptr<RingBufferDataCallback> callback;
+};
+
+static oboe::AudioFormat shim_format_to_oboe(int format)
+{
+	switch (format) {
+	case OBOE_SHIM_FORMAT_I16:
+		return oboe::AudioFormat::I16;
+	case OBOE_SHIM_FORMAT_F32:
+		return oboe::AudioFormat::Float;
+	default:
+		return oboe::AudioFormat::Invalid;
+	}
+}
+
+static int oboe_format_to_shim(oboe::AudioFormat format)
+{
+	switch (format) {
+	case oboe::AudioFormat::I16:
+		return OBOE_SHIM_FORMAT_I16;
+	case oboe::AudioFormat::Float:
+		return OBOE_SHIM_FORMAT_F32;
+	default:
+		return 0;
+	}
+}
+
+static oboe::PerformanceMode shim_perf_to_oboe(int perf_mode)
+{
+	switch (perf_mode) {
+	case OBOE_SHIM_PERF_LOW_LATENCY:
+		return oboe::PerformanceMode::LowLatency;
+	case OBOE_SHIM_PERF_POWER_SAVING:
+		return oboe::PerformanceMode::PowerSaving;
+	case OBOE_SHIM_PERF_NONE:
+	default:
+		return oboe::PerformanceMode::None;
+	}
+}
+
+static oboe::SharingMode shim_sharing_to_oboe(int sharing_mode)
+{
+	return sharing_mode == OBOE_SHIM_SHARING_EXCLUSIVE ?
+		oboe::SharingMode::Exclusive : oboe::SharingMode::Shared;
+}
+
+static int32_t frame_bytes_for_format(int format, int32_t channels)
+{
+	switch (format) {
+	case OBOE_SHIM_FORMAT_I16:
+		return channels * 2;
+	case OBOE_SHIM_FORMAT_F32:
+		return channels * 4;
+	default:
+		return 0;
+	}
+}
+
+static int open_output_stream(OboeShimStream **out, struct oboe_shim_ring *ring,
+		int32_t sample_rate, int32_t channels, int format,
+		int perf_mode, int sharing_mode,
+		oboe_shim_trigger_func trigger_cb, void *trigger_data)
+{
+	if (out == nullptr || ring == nullptr)
+		return -1;
+	*out = nullptr;
+
+	oboe::AudioFormat oboe_fmt = shim_format_to_oboe(format);
+	if (oboe_fmt == oboe::AudioFormat::Invalid)
+		return -1;
+
+	int32_t frame_bytes = frame_bytes_for_format(format, channels);
+	if (frame_bytes <= 0)
+		return -1;
+
+	auto *shim = new (std::nothrow) OboeShimStream();
+	if (shim == nullptr)
+		return -1;
+
+	shim->callback = std::make_unique<RingBufferDataCallback>(ring, frame_bytes,
+			trigger_cb, trigger_data);
+
+	oboe::AudioStreamBuilder builder;
+	builder.setDirection(oboe::Direction::Output);
+	builder.setPerformanceMode(shim_perf_to_oboe(perf_mode));
+	builder.setSharingMode(shim_sharing_to_oboe(sharing_mode));
+	builder.setSampleRate(sample_rate);
+	builder.setChannelCount(channels);
+	builder.setFormat(oboe_fmt);
+	builder.setDataCallback(shim->callback.get());
+	builder.setErrorCallback(shim->callback.get());
+
+	oboe::Result result = builder.openStream(shim->stream);
+	if (result != oboe::Result::OK) {
+		delete shim;
+		return static_cast<int>(result);
+	}
+
+	*out = shim;
+	return 0;
+}
+
+extern "C" int oboe_shim_open_output(OboeShimStream **out, struct oboe_shim_ring *ring,
+		int32_t sample_rate, int32_t channels, int format,
+		int perf_mode, int sharing_mode,
+		oboe_shim_trigger_func trigger_cb, void *trigger_data)
+{
+	return open_output_stream(out, ring, sample_rate, channels, format,
+			perf_mode, sharing_mode, trigger_cb, trigger_data);
+}
+
+extern "C" int oboe_shim_request_start(OboeShimStream *s)
+{
+	if (s == nullptr || !s->stream)
+		return -1;
+	oboe::Result result = s->stream->requestStart();
+	return result == oboe::Result::OK ? 0 : static_cast<int>(result);
+}
+
+extern "C" int32_t oboe_shim_set_buffer_size(OboeShimStream *s, int32_t requested_frames)
+{
+	if (s == nullptr || !s->stream)
+		return -1;
+	oboe::ResultWithValue<int32_t> result =
+		s->stream->setBufferSizeInFrames(requested_frames);
+	if (!result)
+		return static_cast<int32_t>(result.error());
+	return result.value();
+}
+
+extern "C" int32_t oboe_shim_get_frames_per_burst(OboeShimStream *s)
+{
+	if (s == nullptr || !s->stream)
+		return 0;
+	return s->stream->getFramesPerBurst();
+}
+
+extern "C" int32_t oboe_shim_get_xrun_count(OboeShimStream *s)
+{
+	if (s == nullptr || !s->stream)
+		return -1;
+	oboe::ResultWithValue<int32_t> result = s->stream->getXRunCount();
+	if (!result)
+		return static_cast<int32_t>(result.error());
+	return result.value();
+}
+
+extern "C" int32_t oboe_shim_get_underrun_count(OboeShimStream *s)
+{
+	if (s == nullptr || !s->callback)
+		return -1;
+	return s->callback->getUnderrunCount();
+}
+
+extern "C" int oboe_shim_is_disconnected(OboeShimStream *s)
+{
+	if (s == nullptr || !s->callback)
+		return 0;
+	return s->callback->isDisconnected() ? 1 : 0;
+}
+
+extern "C" int32_t oboe_shim_get_sample_rate(OboeShimStream *s)
+{
+	if (s == nullptr || !s->stream)
+		return 0;
+	return s->stream->getSampleRate();
+}
+
+extern "C" int32_t oboe_shim_get_channel_count(OboeShimStream *s)
+{
+	if (s == nullptr || !s->stream)
+		return 0;
+	return s->stream->getChannelCount();
+}
+
+extern "C" int oboe_shim_get_format(OboeShimStream *s)
+{
+	if (s == nullptr || !s->stream)
+		return 0;
+	return oboe_format_to_shim(s->stream->getFormat());
+}
+
+extern "C" void oboe_shim_stop_and_close(OboeShimStream *s)
+{
+	if (s == nullptr)
+		return;
+	if (s->stream) {
+		s->stream->stop();
+		s->stream->close();
+		s->stream.reset();
+	}
+	delete s;
+}
+
+extern "C" const char *oboe_shim_result_to_text(int32_t result)
+{
+	return oboe::convertToText(static_cast<oboe::Result>(result));
+}
diff -ruN a/src/modules/oboe-shim.h b/src/modules/oboe-shim.h
--- a/src/modules/oboe-shim.h	1970-01-01 00:00:00.000000000 +0000
+++ b/src/modules/oboe-shim.h	2026-08-14 09:57:26.529078453 +0000
@@ -0,0 +1,66 @@
+#ifndef OBOE_SHIM_H
+#define OBOE_SHIM_H
+
+#include <stdint.h>
+
+#include <spa/utils/ringbuffer.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct OboeShimStream OboeShimStream;
+
+enum {
+	OBOE_SHIM_FORMAT_I16 = 1,
+	OBOE_SHIM_FORMAT_F32 = 2,
+};
+
+enum {
+	OBOE_SHIM_PERF_NONE         = 0,
+	OBOE_SHIM_PERF_POWER_SAVING = 1,
+	OBOE_SHIM_PERF_LOW_LATENCY  = 2,
+};
+
+enum {
+	OBOE_SHIM_SHARING_SHARED    = 0,
+	OBOE_SHIM_SHARING_EXCLUSIVE = 1,
+};
+
+#define OBOE_SHIM_RING_SIZE (1u << 16)
+#define OBOE_SHIM_RING_MASK (OBOE_SHIM_RING_SIZE - 1)
+
+struct oboe_shim_ring {
+	struct spa_ringbuffer rb;
+	uint32_t active;
+	uint8_t buffer[OBOE_SHIM_RING_SIZE];
+};
+
+typedef void (*oboe_shim_trigger_func)(void *data);
+
+int oboe_shim_open_output(OboeShimStream **out, struct oboe_shim_ring *ring,
+		int32_t sample_rate, int32_t channels, int format,
+		int perf_mode, int sharing_mode,
+		oboe_shim_trigger_func trigger_cb, void *trigger_data);
+
+int oboe_shim_request_start(OboeShimStream *s);
+
+int32_t oboe_shim_set_buffer_size(OboeShimStream *s, int32_t requested_frames);
+int32_t oboe_shim_get_frames_per_burst(OboeShimStream *s);
+int32_t oboe_shim_get_xrun_count(OboeShimStream *s);
+int32_t oboe_shim_get_underrun_count(OboeShimStream *s);
+int oboe_shim_is_disconnected(OboeShimStream *s);
+
+int32_t oboe_shim_get_sample_rate(OboeShimStream *s);
+int32_t oboe_shim_get_channel_count(OboeShimStream *s);
+int oboe_shim_get_format(OboeShimStream *s);
+
+void oboe_shim_stop_and_close(OboeShimStream *s);
+
+const char *oboe_shim_result_to_text(int32_t result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
